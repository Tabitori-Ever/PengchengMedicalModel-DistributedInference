{
  "dashboard": {
    "title": "Edge Inference Platform — Real-time Monitoring",
    "uid": "edge-inference-monitoring",
    "timezone": "browser",
    "refresh": "5s",
    "tags": ["inference", "edge", "medical", "alexnet"],
    "panels": [

      "___ROW_OVERVIEW___": {},

      {
        "id": 1,
        "gridPos": {"x": 0, "y": 0, "w": 4, "h": 3},
        "type": "stat",
        "title": "总请求数",
        "fieldConfig": {
          "defaults": { "color": {"mode": "palette-classic"}, "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]} }
        },
        "targets": [{"expr": "sum(inference_requests_total)", "legendFormat": "Total"}]
      },
      {
        "id": 2,
        "gridPos": {"x": 4, "y": 0, "w": 4, "h": 3},
        "type": "stat",
        "title": "Medical 请求数",
        "fieldConfig": {
          "defaults": { "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]} }
        },
        "targets": [{"expr": "sum(inference_requests_total{model=\"medical\"})", "legendFormat": "Medical"}]
      },
      {
        "id": 3,
        "gridPos": {"x": 8, "y": 0, "w": 4, "h": 3},
        "type": "stat",
        "title": "AlexNet 请求数",
        "fieldConfig": {
          "defaults": { "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "orange", "value": null}]} }
        },
        "targets": [{"expr": "sum(inference_requests_total{model=\"alexnet\"})", "legendFormat": "AlexNet"}]
      },
      {
        "id": 4,
        "gridPos": {"x": 12, "y": 0, "w": 4, "h": 3},
        "type": "stat",
        "title": "当前队列长度",
        "fieldConfig": {
          "defaults": { "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 10}, {"color": "red", "value": 50}]} }
        },
        "targets": [{"expr": "inference_queue_length", "legendFormat": "Queue"}]
      },
      {
        "id": 5,
        "gridPos": {"x": 16, "y": 0, "w": 4, "h": 3},
        "type": "stat",
        "title": "失败请求数",
        "fieldConfig": {
          "defaults": { "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]} }
        },
        "targets": [{"expr": "sum(inference_failed_requests_total)", "legendFormat": "Failed"}]
      },
      {
        "id": 6,
        "gridPos": {"x": 20, "y": 0, "w": 4, "h": 3},
        "type": "stat",
        "title": "正在运行任务",
        "fieldConfig": {
          "defaults": { "color": {"mode": "palette-classic"}, "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]} }
        },
        "targets": [{"expr": "medical_task_running + alexnet_task_running", "legendFormat": "Running"}]
      },

      "___ROW_THROUGHPUT___": {},

      {
        "id": 10,
        "gridPos": {"x": 0, "y": 3, "w": 12, "h": 8},
        "type": "timeseries",
        "title": "实时吞吐量 (请求/秒)",
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "custom": {"fillOpacity": 15, "lineWidth": 2, "spanNulls": true, "showPoints": "never"}
          }
        },
        "targets": [
          {"expr": "sum(rate(inference_requests_total[1m]))", "legendFormat": "总吞吐量"},
          {"expr": "rate(inference_requests_total{model=\"medical\"}[1m])", "legendFormat": "Medical"},
          {"expr": "rate(inference_requests_total{model=\"alexnet\"}[1m])", "legendFormat": "AlexNet"}
        ]
      },
      {
        "id": 11,
        "gridPos": {"x": 12, "y": 3, "w": 12, "h": 8},
        "type": "timeseries",
        "title": "累计请求趋势",
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "custom": {"fillOpacity": 10, "lineWidth": 2, "showPoints": "never"}
          }
        },
        "targets": [
          {"expr": "sum(inference_requests_total)", "legendFormat": "总计"},
          {"expr": "inference_requests_total{model=\"medical\"}", "legendFormat": "Medical"},
          {"expr": "inference_requests_total{model=\"alexnet\"}", "legendFormat": "AlexNet"}
        ]
      },

      "___ROW_QUEUE___": {},

      {
        "id": 20,
        "gridPos": {"x": 0, "y": 11, "w": 8, "h": 6},
        "type": "timeseries",
        "title": "队列长度",
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "custom": {"fillOpacity": 20, "lineWidth": 2, "showPoints": "never"},
            "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 10}, {"color": "red", "value": 50}]}
          }
        },
        "targets": [{"expr": "inference_queue_length", "legendFormat": "Queue Depth"}]
      },
      {
        "id": 21,
        "gridPos": {"x": 8, "y": 11, "w": 8, "h": 6},
        "type": "timeseries",
        "title": "正在运行的任务数",
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "custom": {"fillOpacity": 20, "lineWidth": 2, "showPoints": "never"}
          }
        },
        "targets": [
          {"expr": "medical_task_running", "legendFormat": "Medical Running"},
          {"expr": "alexnet_task_running", "legendFormat": "AlexNet Running"},
          {"expr": "medical_task_running + alexnet_task_running", "legendFormat": "Total Running"}
        ]
      },
      {
        "id": 22,
        "gridPos": {"x": 16, "y": 11, "w": 8, "h": 6},
        "type": "timeseries",
        "title": "失败请求趋势",
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "custom": {"fillOpacity": 20, "lineWidth": 2, "showPoints": "never"}
          }
        },
        "targets": [
          {"expr": "sum(rate(inference_failed_requests_total[1m]))", "legendFormat": "失败率/秒"},
          {"expr": "inference_failed_requests_total{model=\"medical\"}", "legendFormat": "Medical 失败"},
          {"expr": "inference_failed_requests_total{model=\"alexnet\"}", "legendFormat": "AlexNet 失败"}
        ]
      },

      "___ROW_LATENCY___": {},

      {
        "id": 30,
        "gridPos": {"x": 0, "y": 17, "w": 12, "h": 8},
        "type": "timeseries",
        "title": "推理时延 (P50/P95/P99)",
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": {"fillOpacity": 10, "lineWidth": 2, "showPoints": "never"}
          }
        },
        "targets": [
          {"expr": "histogram_quantile(0.50, sum(rate(inference_latency_seconds_bucket{model=\"medical\"}[2m])) by (le))", "legendFormat": "Medical P50"},
          {"expr": "histogram_quantile(0.95, sum(rate(inference_latency_seconds_bucket{model=\"medical\"}[2m])) by (le))", "legendFormat": "Medical P95"},
          {"expr": "histogram_quantile(0.99, sum(rate(inference_latency_seconds_bucket{model=\"medical\"}[2m])) by (le))", "legendFormat": "Medical P99"},
          {"expr": "histogram_quantile(0.50, sum(rate(inference_latency_seconds_bucket{model=\"alexnet\"}[2m])) by (le))", "legendFormat": "AlexNet P50"},
          {"expr": "histogram_quantile(0.95, sum(rate(inference_latency_seconds_bucket{model=\"alexnet\"}[2m])) by (le))", "legendFormat": "AlexNet P95"},
          {"expr": "histogram_quantile(0.99, sum(rate(inference_latency_seconds_bucket{model=\"alexnet\"}[2m])) by (le))", "legendFormat": "AlexNet P99"}
        ]
      },
      {
        "id": 31,
        "gridPos": {"x": 12, "y": 17, "w": 12, "h": 8},
        "type": "timeseries",
        "title": "各阶段推理时延 (P95)",
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": {"fillOpacity": 10, "lineWidth": 2, "showPoints": "never"}
          }
        },
        "targets": [
          {"expr": "histogram_quantile(0.95, sum(rate(inference_stage_latency_seconds_bucket{stage=\"worker\"}[2m])) by (le))", "legendFormat": "Medical Worker"},
          {"expr": "histogram_quantile(0.95, sum(rate(inference_stage_latency_seconds_bucket{stage=\"server\"}[2m])) by (le))", "legendFormat": "Medical Server"},
          {"expr": "histogram_quantile(0.95, sum(rate(inference_stage_latency_seconds_bucket{stage=\"part1\"}[2m])) by (le))", "legendFormat": "AlexNet Part1"},
          {"expr": "histogram_quantile(0.95, sum(rate(inference_stage_latency_seconds_bucket{stage=\"part2\"}[2m])) by (le))", "legendFormat": "AlexNet Part2"}
        ]
      },

      "___ROW_SERVICE___": {},

      {
        "id": 40,
        "gridPos": {"x": 0, "y": 25, "w": 6, "h": 6},
        "type": "timeseries",
        "title": "Worker 请求速率",
        "fieldConfig": {
          "defaults": { "unit": "reqps", "custom": {"fillOpacity": 15, "lineWidth": 2, "showPoints": "never"} }
        },
        "targets": [{"expr": "rate(medical_worker_requests_total[1m])", "legendFormat": "Worker req/s"}]
      },
      {
        "id": 41,
        "gridPos": {"x": 6, "y": 25, "w": 6, "h": 6},
        "type": "timeseries",
        "title": "Server 请求速率",
        "fieldConfig": {
          "defaults": { "unit": "reqps", "custom": {"fillOpacity": 15, "lineWidth": 2, "showPoints": "never"} }
        },
        "targets": [{"expr": "rate(medical_server_requests_total[1m])", "legendFormat": "Server req/s"}]
      },
      {
        "id": 42,
        "gridPos": {"x": 12, "y": 25, "w": 6, "h": 6},
        "type": "timeseries",
        "title": "Part1 请求速率",
        "fieldConfig": {
          "defaults": { "unit": "reqps", "custom": {"fillOpacity": 15, "lineWidth": 2, "showPoints": "never"} }
        },
        "targets": [{"expr": "rate(alexnet_part1_requests_total[1m])", "legendFormat": "Part1 req/s"}]
      },
      {
        "id": 43,
        "gridPos": {"x": 18, "y": 25, "w": 6, "h": 6},
        "type": "timeseries",
        "title": "Part2 请求速率",
        "fieldConfig": {
          "defaults": { "unit": "reqps", "custom": {"fillOpacity": 15, "lineWidth": 2, "showPoints": "never"} }
        },
        "targets": [{"expr": "rate(alexnet_part2_requests_total[1m])", "legendFormat": "Part2 req/s"}]
      },

      {
        "id": 44,
        "gridPos": {"x": 0, "y": 31, "w": 12, "h": 6},
        "type": "timeseries",
        "title": "各服务正在处理的任务数",
        "fieldConfig": {
          "defaults": { "unit": "none", "custom": {"fillOpacity": 20, "lineWidth": 2, "showPoints": "never"} }
        },
        "targets": [
          {"expr": "medical_worker_running_tasks", "legendFormat": "Worker"},
          {"expr": "medical_server_running_tasks", "legendFormat": "Server"},
          {"expr": "alexnet_part1_running_tasks", "legendFormat": "Part1"},
          {"expr": "alexnet_part2_running_tasks", "legendFormat": "Part2"}
        ]
      },
      {
        "id": 45,
        "gridPos": {"x": 12, "y": 31, "w": 12, "h": 6},
        "type": "timeseries",
        "title": "各服务推理时延 (P95)",
        "fieldConfig": {
          "defaults": { "unit": "s", "custom": {"fillOpacity": 10, "lineWidth": 2, "showPoints": "never"} }
        },
        "targets": [
          {"expr": "histogram_quantile(0.95, sum(rate(medical_worker_latency_seconds_bucket[2m])) by (le))", "legendFormat": "Worker"},
          {"expr": "histogram_quantile(0.95, sum(rate(medical_server_latency_seconds_bucket[2m])) by (le))", "legendFormat": "Server"},
          {"expr": "histogram_quantile(0.95, sum(rate(alexnet_part1_latency_seconds_bucket[2m])) by (le))", "legendFormat": "Part1"},
          {"expr": "histogram_quantile(0.95, sum(rate(alexnet_part2_latency_seconds_bucket[2m])) by (le))", "legendFormat": "Part2"}
        ]
      },

      "___ROW_TASK_LIST___": {},

      {
        "id": 90,
        "gridPos": {"x": 0, "y": 37, "w": 24, "h": 6},
        "type": "text",
        "title": "任务详情查询",
        "options": {
          "content": "# 查看运行中的任务\n\nGrafana 不直接存储 task_id（Prometheus 不适合高基数标签），请通过以下 API 查询：\n\n- **任务列表**: `curl http://scheduler-service:8000/tasks`\n- **运行中的任务**: `curl http://scheduler-service:8000/tasks/running`\n- **任务统计**: `curl http://scheduler-service:8000/tasks/stats`\n- **单个任务**: `curl http://scheduler-service:8000/task/result/{task_id}`\n\nPort-forward: `kubectl port-forward svc/scheduler-service 8000:8000`",
          "mode": "markdown"
        }
      }
    ],

    "schemaVersion": 39,
    "time": {"from": "now-15m", "to": "now"}
  }
}
