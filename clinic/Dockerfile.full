# ============================================================
# Clinic Pod image v3.0 (from-scratch build; needs PyPI access)
# Terminal/edge initiator + P2P data peer; also carries the
# routine-task entrypoint used by short-lived Kubernetes Jobs.
# ============================================================
FROM python:3.11-slim AS builder

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc g++ && \
    rm -rf /var/lib/apt/lists/*

COPY clinic/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# --- runtime stage: drop gcc/g++ ---
FROM python:3.11-slim

WORKDIR /app

COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

COPY clinic/app.py /app/
COPY clinic/run_routine.py /app/run_routine.py
COPY common/v3_common.py /app/common/v3_common.py
COPY common/local_exec.py /app/common/local_exec.py

EXPOSE 8007

CMD ["python", "-m", "uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8007", "--no-access-log"]
